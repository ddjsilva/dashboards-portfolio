---
import { Image } from 'astro:assets';
import type { CollectionEntry } from 'astro:content';

interface Props {
  project: CollectionEntry<'projetos'>;
  delay?: number;
}

const { project, delay = 0 } = Astro.props;
const { title, area, summary, problem, cover, coverAlt, embedUrl } = project.data;
const ready = Boolean(embedUrl);
const Tag = ready ? 'a' : 'div';
---

<article data-reveal style={`--reveal-delay:${delay}`}>
  <Tag
    href={ready ? `/projetos/${project.id}` : undefined}
    class:list={[
      'group block h-full rounded-[1.25rem] border border-white/[.08] bg-white/[.03] p-2.5 transition-colors duration-300',
      ready && 'hover:border-lilac-500/50 hover:bg-white/[.06]',
    ]}
  >
    <div class="relative aspect-video overflow-hidden rounded-xl bg-night-line">
      <Image
        src={cover}
        alt={coverAlt}
        widths={[480, 720, 960, 1280]}
        sizes="(min-width: 1024px) 560px, (min-width: 768px) 46vw, 92vw"
        class:list={[
          'size-full object-cover object-top transition-transform duration-700 ease-out-soft',
          ready ? 'group-hover:scale-[1.03]' : 'opacity-40 grayscale',
        ]}
      />
      {
        !ready && (
          <span class="absolute inset-0 grid place-items-center">
            <span class="rounded-full bg-night/80 px-4 py-1.5 text-sm text-white backdrop-blur">Em breve</span>
          </span>
        )
      }
    </div>

    <div class="flex flex-col gap-3 px-2.5 pt-5 pb-3 sm:px-3.5">
      <div class="flex flex-wrap items-center gap-x-3 gap-y-1 text-sm">
        <span class="rounded-full bg-lilac-500/15 px-2.5 py-0.5 text-lilac-300">{area}</span>
        <span class="text-white/55">{problem}</span>
      </div>
      <h3 class="text-2xl text-white">{title}</h3>
      <p class="text-base text-white/65">{summary}</p>
      {
        ready && (
          <span class="mt-1 inline-flex items-center gap-2 text-base font-medium text-lilac-300">
            Ver case
            <svg viewBox="0 0 16 16" class="size-3.5 transition-transform duration-300 group-hover:translate-x-1" aria-hidden="true">
              <path d="M3 8h10M9 4l4 4-4 4" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" />
            </svg>
          </span>
        )
      }
    </div>
  </Tag>
</article>
